generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TUTOR
  ESTABLISHMENT
  PROFESSIONAL
  ADMIN
}

enum ApprovalStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(TUTOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  pets                 Pet[]
  establishmentProfile EstablishmentProfile?
  professionalProfile  ProfessionalProfile?
  adminProfile         AdminProfile?

  servicesAsEstablishment Service[] @relation("EstablishmentServices")
  servicesAsProfessional  Service[] @relation("ProfessionalServices")
  appointmentsAsTutor     Appointment[] @relation("TutorAppointments")
  appointmentsAsEstablishment Appointment[] @relation("EstablishmentAppointments")
  appointmentsAsProfessional Appointment[] @relation("ProfessionalAppointments")
}

model Pet {
  id        String   @id @default(uuid())
  name      String
  species   String
  breed     String?
  photo     String?
  tutorId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor        User          @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model EstablishmentProfile {
  id          String         @id @default(uuid())
  userId      String         @unique
  status      ApprovalStatus @default(PENDING_APPROVAL)
  description String?
  address     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthIntegration OAuthIntegration?
}

model ProfessionalProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  specialty   String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthIntegration {
  id                     String   @id @default(uuid())
  establishmentProfileId String   @unique
  provider               String   @default("google")
  accessToken            String
  refreshToken           String
  expiryDate             DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  establishmentProfile   EstablishmentProfile @relation(fields: [establishmentProfileId], references: [id], onDelete: Cascade)
}

model Service {
  id              String   @id @default(uuid())
  name            String
  description     String?
  price           Float
  duration        Int      // Duration in minutes
  establishmentId String?
  professionalId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment   User?    @relation("EstablishmentServices", fields: [establishmentId], references: [id])
  professional    User?    @relation("ProfessionalServices", fields: [professionalId], references: [id])
  appointments    Appointment[]
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Appointment {
  id              String            @id @default(uuid())
  tutorId         String
  petId           String
  serviceId       String
  establishmentId String
  professionalId  String?
  date            DateTime
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  service         Service           @relation(fields: [serviceId], references: [id])
  tutor           User              @relation("TutorAppointments", fields: [tutorId], references: [id])
  pet             Pet               @relation(fields: [petId], references: [id])
  establishment   User              @relation("EstablishmentAppointments", fields: [establishmentId], references: [id])
  professional    User?             @relation("ProfessionalAppointments", fields: [professionalId], references: [id])
}
