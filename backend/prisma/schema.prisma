generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                @id @default(uuid())
  name                        String
  email                       String                @unique
  password                    String
  hasPassword                 Boolean               @default(false)
  phone                       String?
  document                    String?
  role                        Role                  @default(TUTOR)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  avatar                      String?
  defaultAvatar               String?
  preferences                  Json?
  address                     String?
  number                      String?
  complement                  String?
  neighborhood                String?
  city                        String?
  state                       String?
  zipCode                     String?
  paymentMethods              PaymentMethod[]
  cashbackTransactions        CashbackTransaction[]
  adminProfile                AdminProfile?
  appointmentsAsEstablishment Appointment[]         @relation("EstablishmentAppointments")
  appointmentsAsProfessional  Appointment[]         @relation("ProfessionalAppointments")
  appointmentsAsTutor         Appointment[]         @relation("TutorAppointments")
  cartItemsAsTutor            CartItem[]            @relation("TutorCartItems")
  establishmentProfile        EstablishmentProfile?
  ordersAsTutor               Order[]               @relation("TutorOrders")
  orderItemsAsEstablishment   OrderItem[]           @relation("EstablishmentOrderItems")
  pets                        Pet[]
  productsAsEstablishment     Product[]             @relation("EstablishmentProducts")
  professionalProfile         ProfessionalProfile?
  servicesAsEstablishment     Service[]             @relation("EstablishmentServices")
  servicesAsProfessional      Service[]             @relation("ProfessionalServices")
  employeesAsEstablishment    Employee[]            @relation("EstablishmentEmployees")
  notifications               Notification[]
  googleCalendarConnection    GoogleCalendarConnection?
  conversationsAsP1           Conversation[]            @relation("ConversationParticipant1")
  conversationsAsP2           Conversation[]            @relation("ConversationParticipant2")
  messagesSent                Message[]
  reportsCreated              ModerationReport[]        @relation("ReportsCreated")
  reportsReceived             ModerationReport[]        @relation("ReportsReceived")
  reportsResolved             ModerationReport[]        @relation("ReportsResolved")
  adminAuditLogs              AdminAuditLog[]
  termsAcceptances            TermsAcceptance[]
  cashbackVouchers            CashbackVoucher[]
  partnerProgramParticipation PartnerProgramParticipation?
  partnerPayoutsAsEstablishment PartnerPayout[]       @relation("EstablishmentPartnerPayouts")
  reviewsAsTutor              Review[]                  @relation("TutorReviews")
  reviewsAsEstablishment      Review[]                  @relation("EstablishmentReviews")
  reviewsAsProfessional       Review[]                  @relation("ProfessionalReviews")
}

model Pet {
  id           String        @id @default(uuid())
  name         String
  species      String
  breed        String?
  gender       String?
  birthDate    DateTime?
  weight       Float?
  approximateAge String?
  vaccinationStatus String? @default("UNKNOWN")
  notes        String?
  photo        String?
  coverPhoto   String?
  isNeutered        Boolean?
  behaviorNotes     String?
  specialCareNotes  String?
  vaccines          Json?         @default("[]")
  tutorId      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  tutor        User          @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

model EstablishmentProfile {
  id               String            @id @default(uuid())
  userId           String            @unique
  status           ApprovalStatus    @default(PENDING_APPROVAL)
  description      String?
  address          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  document         String?
  businessName     String?
  type             String?
  city             String?
  state            String?
  zipCode          String?
  phone            String?
  email            String?
  workingHours     Json?
  photos           String[]
  acceptedSpecies  String[]          @default([])
  rejectionReason  String?
  suspendedUntil   DateTime?
  suspensionReason String?
  suspendedAt      DateTime?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportsReceived  ModerationReport[]
}

model ProfessionalProfile {
  id               String         @id @default(uuid())
  userId           String         @unique
  specialty        String?
  bio              String?
  acceptedSpecies  String[]       @default([])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  document         String?
  rejectionReason  String?
  suspendedUntil   DateTime?
  suspensionReason String?
  suspendedAt      DateTime?
  status           ApprovalStatus @default(PENDING_APPROVAL)
  workingHours     Json?
  bookingSettings  Json?
  workplacePhoto   String?
  address          String?
  number           String?
  complement       String?
  neighborhood     String?
  city             String?
  state            String?
  zipCode          String?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleCalendarConnection {
  id             String              @id @default(uuid())
  userId         String              @unique
  provider       String              @default("GOOGLE")
  googleEmail    String?
  calendarId     String              @default("primary")
  calendarName   String?             @default("Agenda Principal")
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  syncEnabled    Boolean             @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventSyncs     CalendarEventSync[]
  logs           CalendarSyncLog[]
}

model CalendarEventSync {
  id            String                   @id @default(uuid())
  appointmentId String
  connectionId  String
  googleEventId String
  calendarId    String                   @default("primary")
  syncStatus    String                   @default("SYNCED") // "SYNCED" | "PENDING" | "FAILED" | "CANCELLED"
  lastSyncedAt  DateTime?                @default(now())
  lastError     String?
  retryCount    Int                      @default(0)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  appointment   Appointment              @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  connection    GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, connectionId])
}

model CalendarSyncLog {
  id           String                   @id @default(uuid())
  connectionId String
  action       String                   // "EVENT_CREATED" | "EVENT_UPDATED" | "EVENT_CANCELLED" | "MANUAL_SYNC" | "ERROR"
  status       String                   // "SUCCESS" | "FAILED"
  title        String
  details      String?
  createdAt    DateTime                 @default(now())
  connection   GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model Service {
  id              String        @id @default(uuid())
  name            String
  description     String?
  price           Float
  duration        Int
  image           String?
  category        String?
  animalType      String?
  active          Boolean       @default(true)
  establishmentId String?
  professionalId  String?
  employeeId      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
  employees       EmployeeService[]
  establishment   User?         @relation("EstablishmentServices", fields: [establishmentId], references: [id], onDelete: Cascade)
  professional    User?         @relation("ProfessionalServices", fields: [professionalId], references: [id], onDelete: Cascade)
  reviews         Review[]
}

model Appointment {
  id              String            @id @default(uuid())
  tutorId         String
  petId           String
  serviceId       String
  establishmentId String
  professionalId  String?
  employeeId      String?
  date                   DateTime
  status                 AppointmentStatus @default(PENDING)
  paymentMethod          String?
  paymentStatus          String?           @default("PENDING")
  totalAmount            Float?
  discountAmount         Float?            @default(0)
  cashbackCodeApplied    String?
  cashbackDiscount       Float?            @default(0)
  finalAmount            Float?
  needsChange            Boolean?          @default(false)
  changeFor              Float?
  cashbackCredited       Boolean           @default(false)
  cashbackAmountCredited Float?
  confirmedByTutor       Boolean           @default(false)
  confirmedByTutorAt     DateTime?
  petTransport           String?           @default("PICKUP_BY_TUTOR") // 'PICKUP_BY_TUTOR' | 'PICKUP_BY_PROVIDER'
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  establishment          User              @relation("EstablishmentAppointments", fields: [establishmentId], references: [id], onDelete: Cascade)
  pet             Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
  professional    User?             @relation("ProfessionalAppointments", fields: [professionalId], references: [id], onDelete: Cascade)
  employee        Employee?         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tutor           User              @relation("TutorAppointments", fields: [tutorId], references: [id], onDelete: Cascade)
  calendarEventSyncs CalendarEventSync[]
  partnerPayout   PartnerPayout?
  review          Review?
}

model Product {
  id              String      @id @default(uuid())
  name            String
  description     String?
  category        String?
  price           Float
  stock           Int         @default(0)
  photo           String?
  establishmentId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  cartItems       CartItem[]
  orderItems      OrderItem[]
  establishment   User        @relation("EstablishmentProducts", fields: [establishmentId], references: [id], onDelete: Cascade)
}

model Order {
  id                     String      @id @default(uuid())
  tutorId                String
  totalAmount            Float
  subtotalAmount         Float?
  discountAmount         Float?      @default(0)
  cashbackCodeApplied    String?
  cashbackDiscount       Float?      @default(0)
  cashbackCredited       Boolean     @default(false)
  cashbackAmountCredited Float?
  status                 OrderStatus @default(PENDING)
  paymentMethod          String?
  deliveryMethod  String?     // 'DELIVERY' | 'PICKUP'
  deliveryAddress Json?
  needsChange     Boolean?    @default(false)
  changeFor       Float?
  notes           String?
  cancelledAt     DateTime?
  cancelledBy     String?     // 'ESTABLISHMENT' | 'TUTOR'
  cancellationReason String?
  cancellationNotes  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tutor           User        @relation("TutorOrders", fields: [tutorId], references: [id], onDelete: Cascade)
  items           OrderItem[]
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String
  quantity        Int
  priceAtTime     Float
  establishmentId String
  createdAt       DateTime @default(now())
  establishment   User     @relation("EstablishmentOrderItems", fields: [establishmentId], references: [id], onDelete: Cascade)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        String   @id @default(uuid())
  tutorId   String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tutor     User     @relation("TutorCartItems", fields: [tutorId], references: [id], onDelete: Cascade)
}

enum Role {
  TUTOR
  ESTABLISHMENT
  PROFESSIONAL
  ADMIN
}

enum ApprovalStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  PREPARING
  SHIPPED
  READY_FOR_PICKUP
  DELIVERED
  COMPLETED
  CANCELLED
}

model PaymentMethod {
  id        String   @id @default(uuid())
  userId    String
  brand     String
  lastFour  String
  holder    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CashbackTransaction {
  id             String   @id @default(uuid())
  userId         String
  amount         Float
  type           String   // 'EARNED' | 'REDEEMED'
  description    String
  code           String?  // Unique single-use code for redemption
  originType     String?  // 'ORDER' | 'APPOINTMENT' | 'REDEMPTION'
  orderId        String?
  appointmentId  String?
  rate           Float?
  eligibleAmount Float?
  status         String   @default("COMPLETED")
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model CashbackVoucher {
  id            String    @id @default(uuid())
  code          String    @unique
  tutorId       String
  amount        Float
  status        String    @default("ACTIVE") // 'ACTIVE' | 'USED' | 'CANCELLED'
  usedAt        DateTime?
  orderId       String?
  appointmentId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tutor         User      @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([code])
  @@index([status])
}

model TermsAcceptance {
  id         String   @id @default(uuid())
  userId     String
  termType   String   // 'CASHBACK_POLICY'
  version    String   // '1.0'
  accepted   Boolean  @default(true)
  ipAddress  String?
  userAgent  String?
  acceptedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termType, version])
  @@index([userId])
}

model Employee {
  id              String            @id @default(uuid())
  establishmentId String
  name            String
  role            String
  phone           String?
  description     String?
  avatar          String?
  active          Boolean           @default(true)
  workingDays     Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  establishment   User              @relation("EstablishmentEmployees", fields: [establishmentId], references: [id], onDelete: Cascade)
  services        EmployeeService[]
  appointments    Appointment[]
}

model EmployeeService {
  id         String   @id @default(uuid())
  employeeId String
  serviceId  String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   // 'APPOINTMENT' | 'ORDER' | 'SYSTEM'
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthVerificationCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Conversation {
  id             String    @id @default(uuid())
  participant1Id String
  participant2Id String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastMessageAt  DateTime  @default(now())
  participant1   User      @relation("ConversationParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2   User      @relation("ConversationParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

enum ReportTargetType {
  USER
  ESTABLISHMENT
  PROFESSIONAL
  REVIEW
  CONTENT
}

enum ReportStatus {
  NOVA
  EM_ANALISE
  RESOLVIDA
  ARQUIVADA
}

enum ReportPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model ModerationReport {
  id                      String                @id @default(uuid())
  reportNumber            Int                   @default(autoincrement())
  reporterId              String
  reportedUserId          String?
  reportedEstablishmentId String?
  targetType              ReportTargetType
  reason                  String
  description             String
  status                  ReportStatus          @default(NOVA)
  priority                ReportPriority        @default(MEDIA)
  adminNotes              String?
  decisionReason          String?
  resolvedById            String?
  resolvedAt              DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  reporter                User                  @relation("ReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser            User?                 @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedEstablishment   EstablishmentProfile? @relation(fields: [reportedEstablishmentId], references: [id], onDelete: SetNull)
  resolvedBy              User?                 @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([targetType])
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model PartnerProgramParticipation {
  id               String         @id @default(uuid())
  establishmentId  String         @unique
  status           String         @default("PENDING") // 'PENDING' | 'ACTIVE' | 'DECLINED' | 'SUSPENDED'
  termsVersion     String         @default("1.0")
  acceptedAt       DateTime?
  declinedAt       DateTime?
  suspendedAt      DateTime?
  remunerationRate Float          @default(0.70) // 70% of eligible service value
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  establishment    User           @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([status])
}

model PartnerPayout {
  id               String         @id @default(uuid())
  establishmentId  String
  appointmentId    String         @unique // Guarantee: one payout per appointment! Idempotent
  planId           String?
  serviceId        String
  serviceName      String
  servicePrice     Float
  remunerationRate Float          @default(0.70)
  payoutAmount     Float
  status           String         @default("CALCULATED") // 'CALCULATED' | 'APPROVED' | 'PAID' | 'CANCELLED'
  periodMonth      String         // 'YYYY-MM' (e.g. '2026-09')
  paidAt           DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  establishment    User           @relation("EstablishmentPartnerPayouts", fields: [establishmentId], references: [id], onDelete: Cascade)
  appointment      Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@index([status])
  @@index([periodMonth])
}

model Review {
  id              String       @id @default(uuid())
  appointmentId   String?      @unique
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  tutorId         String
  tutor           User         @relation("TutorReviews", fields: [tutorId], references: [id], onDelete: Cascade)
  establishmentId String?
  establishment   User?        @relation("EstablishmentReviews", fields: [establishmentId], references: [id], onDelete: Cascade)
  professionalId  String?
  professional    User?        @relation("ProfessionalReviews", fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  rating          Int          // 1 to 5
  comment         String
  petPhotoUrl     String?
  reply           String?
  replyCreatedAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([establishmentId])
  @@index([professionalId])
  @@index([tutorId])
}

